// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Auteur {
  id           String    @id @default(uuid()) @db.Uuid
  voornaam     String    @db.VarChar(255)
  achternaam   String    @db.VarChar(255)
  geboortedatum DateTime
  nationaliteit String   @db.VarChar(255)
  biografie     String?  
  aangemaakt    DateTime @default(now())
  upgedate      DateTime @updatedAt

  @@unique(name: "auteurID", [voornaam, achternaam])
  Boeken       Boek[]    @relation("BoekAuteur")
}

model Boek {
  id            String    @id @default(uuid()) @db.Uuid
  ISBN          String    @unique
  titel         String    @db.VarChar(255)
  genre         String    @db.VarChar(100)
  publicatie_datum DateTime
  taal          String    @db.VarChar(50)
  paginas       Int
  vrije_kopieen Int
  totale_kopieen Int
  beschrijving  String   
  cover_uri     String?   @db.VarChar(255)
  aangemaakt    DateTime @default(now())
  upgedate      DateTime @updatedAt
  actief        Boolean

  auteur_id     String    @db.Uuid
  auteur        Auteur    @relation("BoekAuteur", fields: [auteur_id], references: [id])

  BoekKopie     BoekKopie[] 
}

model BoekKopie {
  id             String    @id @default(uuid()) @db.Uuid
  boek_id        String    @db.Uuid
  status         String    @db.VarChar(50)
  extra_informatie String? @db.VarChar(255)
  aangemaakt     DateTime  @default(now())
  upgedate       DateTime  @updatedAt
  actief        Boolean
  boek           Boek      @relation(fields: [boek_id], references: [id])

  Reservaties    Reservatie[]
}

model Gebruiker {
  id             String    @id @default(uuid()) @db.Uuid
  voornaam       String    @db.VarChar(255)
  achternaam     String    @db.VarChar(255)
  geboortedatum  DateTime
  email          String    @unique
  rol            String    @db.VarChar(50)
  hashed_password String   @db.VarChar(255)
  aangemaakt     DateTime  @default(now())
  upgedate       DateTime  @updatedAt
  actief        Boolean
  Reservaties    Reservatie[]
  Password_resets PasswordReset[] 
}
model PasswordReset {
  gebruiker_id   String    @id @default(uuid()) @db.Uuid
  hashed_token   String    @db.VarChar(255)
  aangemaakt     DateTime  @default(now())
  vervalt_binnen DateTime
  gebruiker      Gebruiker @relation(fields: [gebruiker_id], references: [id])
}

model Reservatie {
  id             String    @id @default(uuid()) @db.Uuid
  boek_kopie_id  String    @db.Uuid
  gebruiker_id   String    @db.Uuid
  startdatum     DateTime
  einddatum      DateTime
  status         String    @db.VarChar(50)

  boek_kopie     BoekKopie @relation(fields: [boek_kopie_id], references: [id])
  gebruiker      Gebruiker @relation(fields: [gebruiker_id], references: [id])
}
